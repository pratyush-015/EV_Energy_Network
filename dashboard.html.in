<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VYOMA · Network operations</title><style>
*{box-sizing:border-box}body{margin:0;background:#f4f4ed;color:#172f2c;font:15px "Segoe UI",system-ui,sans-serif}header{background:#103631;color:#f8f9ec;padding:28px max(5vw,20px) 35px;border-bottom:5px solid #c7e774}header b{letter-spacing:.24em;font-size:18px}h1{font:normal clamp(34px,5vw,64px) Georgia,serif;margin:23px 0 8px}header p{color:#c2d6ce;margin:0}main{max-width:1280px;margin:auto;padding:22px 4vw}nav,.grid,.plots{display:flex;flex-wrap:wrap;gap:12px}nav{align-items:end;margin:0 0 20px}label{display:grid;gap:5px;font-weight:600}select{font:inherit;background:white;border:1px solid #a6b7ab;padding:8px 16px;border-radius:5px}.card,article,section{background:#fffefa;border:1px solid #d1d7ca;border-radius:9px;padding:18px}.card{flex:1;min-width:175px}.card strong{display:block;font-size:34px;margin:6px 0}.flag{color:#286540}.miss{color:#a34020}.plots{margin:15px 0}.plots article{flex:1;min-width:min(100%,340px)}h2{font:normal 24px Georgia,serif;margin:2px 0 12px}svg{width:100%;height:auto}small{color:#52635d}.table{overflow:auto}table{border-collapse:collapse;width:100%;white-space:nowrap}th,td{padding:10px 12px;text-align:right;border-bottom:1px solid #e1e4db}th:first-child,td:first-child{text-align:left}a{color:#116552}footer{padding:18px 0;line-height:1.7}svg text{fill:#52635d;font:11px system-ui}
</style></head><body><header><b>VYOMA</b><h1>Network operations</h1><p>Charging, swap inventory and power procurement across five Indian metros</p></header><main><nav><label>Operating scenario<select id="scenario"></select></label><label>Dispatch view<select id="city"></select></label></nav><div class="grid" id="cards"></div><div class="plots"><article><h2>Demand and delivery</h2><small>Hourly MWh · forecast in grey · delivered in green</small><div id="flow"></div></article><article><h2>Energy in storage</h2><small>Hourly MWh · stationary battery closing balance</small><div id="soc"></div></article></div><section><h2>Cluster performance</h2><div class="table"><table><thead><tr><th>Cluster</th><th>Reliability</th><th>Loss</th><th>EBITDA margin</th><th>EBITDA (₹ lakh)</th><th>Targets</th></tr></thead><tbody id="ranking"></tbody></table></div></section><section style="margin-top:15px"><h2>Dispatch ledger</h2><label>Delivery day<select id="day"></select></label><div class="table"><table><thead><tr><th>Hour IST</th><th>Delivered MWh</th><th>Swaps</th><th>Ready packs</th><th>Reserve packs</th><th>Renewable MWh</th><th>Tariff ₹/kWh¹</th></tr></thead><tbody id="ledger"></tbody></table></div><small>¹ Network view shows the delivered-energy-weighted tariff.</small></section><footer><a href="dispatch.csv">Hourly dispatch CSV</a> · <a href="day_ahead_bids.csv">Day-ahead bids CSV</a> · <a href="forecast_validation.csv">Forecast validation CSV</a> · <a href="scorecard.csv">Scorecard CSV</a><br><small>Seeded simulation · Synthetic operating data · All times in India Standard Time</small></footer></main>
<script>
const [rows,scores,meta]=__DATA__;
const el=id=>document.getElementById(id), unique=a=>[...new Set(a)], fmt=(v,d=1)=>v.toLocaleString('en-IN',{minimumFractionDigits:d,maximumFractionDigits:d});
function options(id,items){for(const x of items)el(id).add(new Option(x,x))}
options('scenario',unique(rows.map(r=>r.scenario)));options('city',['Network',...unique(rows.map(r=>r.city))]);options('day',unique(rows.map(r=>r.time.slice(0,10))));
function plot(id,data,fields,colors){
 const top=Math.max(1,...data.flatMap(r=>fields.map(k=>r[k])))*1.04;
 const x=i=>40+400*i/Math.max(1,data.length-1), y=v=>151-129*v/top;
 let svg='';
 for(let i=0;i<=3;i++){const v=top*i/3;svg+='<path stroke="#e2e6dd" d="M40 '+y(v)+'H440"/><text x="34" y="'+(y(v)+4)+'" text-anchor="end">'+Math.round(v)+'</text>'}
 fields.forEach((k,i)=>{svg+='<polyline fill="none" stroke="'+colors[i]+'" stroke-width="2.8" points="'+data.map((r,j)=>x(j)+','+y(r[k])).join(' ')+'"/>'});
 for(const i of [0,Math.floor(data.length/2),data.length-1])svg+='<text x="'+x(i)+'" y="175" text-anchor="middle">'+data[i].time.slice(5,10)+' '+data[i].time.slice(11,13)+'h</text>';
 el(id).innerHTML='<svg viewBox="0 0 480 185" role="img" aria-label="'+id+' hourly trend">'+svg+'</svg>'
}
function draw(){
 const sc=el('scenario').value,city=el('city').value;
 const group=scores.filter(r=>r.scenario===sc),s=group.find(r=>r.city===city);
 const clusters=group.filter(r=>r.city!=='Network'),margin=city==='Network'?Math.min(...clusters.map(r=>r.margin)):s.margin;
 const cards=[['Service reliability',s.reliability,89.7,'≥',s.reliability>=89.7],['Energy losses',s.loss,8,'≤',s.loss<=8],[city==='Network'?'Lowest cluster margin':'EBITDA margin',margin,12,'>',margin>12]];
 el('cards').innerHTML=cards.map(([name,v,t,sign,ok])=>'<div class="card">'+name+'<strong>'+fmt(v,2)+'%</strong><span class="'+(ok?'flag':'miss')+'">'+(ok?'Met':'Missed')+' · '+sign+' '+t+'%</span></div>').join('');
 el('cards').innerHTML+='<div class="card">Accepted requests served<strong>'+fmt(s.fulfillment,2)+'%</strong><small>After tariff response</small></div>';
 el('ranking').innerHTML=clusters.map(r=>'<tr><td>'+r.city+'</td>'+[r.reliability,r.loss,r.margin].map(v=>'<td>'+fmt(v,2)+'%</td>').join('')+'<td>'+fmt(r.ebitda/1e5,2)+'</td><td>'+((r.margin>12&&r.loss<=8&&r.reliability>=89.7)?'Met':'Missed')+'</td></tr>').join('');
 const hours=new Map();
 for(const r of rows.filter(r=>r.scenario===sc&&(city==='Network'||r.city===city))){
 let o=hours.get(r.time)||{time:r.time,tariff_sum:0};for(const k of ['forecast_mwh','sold_mwh','soc_mwh','served_swaps','ready_packs','reserve_packs','renewable_mwh'])o[k]=(o[k]||0)+r[k];
 o.tariff_sum+=r.price_inr_kwh*r.sold_mwh;hours.set(r.time,o)}
 const series=[...hours.values()];plot('flow',series,['forecast_mwh','sold_mwh'],['#909d96','#1a7254']);plot('soc',series,['soc_mwh'],['#3269a0']);
 el('ledger').innerHTML=series.filter(r=>r.time.startsWith(el('day').value)).map(r=>'<tr><td>'+r.time.slice(11,16)+'</td>'+[r.sold_mwh,r.served_swaps,r.ready_packs,r.reserve_packs,r.renewable_mwh,r.tariff_sum/(r.sold_mwh||1)].map((v,i)=>'<td>'+fmt(v,[1,0,0,0,1,2][i])+'</td>').join('')+'</tr>').join('');
}
for(const id of ['scenario','city','day'])el(id).onchange=draw;draw();
</script></body></html>
